#!/bin/sh /etc/rc.common

# shellcheck disable=SC2034
USE_PROCD=1
START=99

prog_name="QUICTun"
bin="/usr/bin/$prog_name"
tmp_folder="/tmp/$prog_name"

write_opt() {
    cfg="$1"
    opt="$2"
    val=""

    config_get val "$cfg" "$opt"
    [ -n "$val" ] && printf '\t%s = %s\n' "$opt" "$val" >>"$conf"
}

write_peer_section() {
    peer_cfg="$1"
    target_instance="$2"
    peer_instance=""
    cert_hash=""
    wg_endpoint=""

    config_get peer_instance "$peer_cfg" instance
    [ "$peer_instance" = "$target_instance" ] || return 0

    config_get cert_hash "$peer_cfg" PeerCertSHA256
    config_get wg_endpoint "$peer_cfg" WgEndpoint

    [ -n "$cert_hash" ] || return 0
    [ -n "$wg_endpoint" ] || return 0

    {
        echo
        echo "[Peer]"
        printf '\tPeerCertSHA256 = %s\n' "$cert_hash"
        printf '\tWgEndpoint = %s\n' "$wg_endpoint"
    } >>"$conf"
}

instance_parse() {
    cfg="$1"
    enabled=""

    config_get_bool enabled "$cfg" enabled 1
    [ "$enabled" -eq 1 ] || return 0

    mkdir -p "$tmp_folder"
    conf="$tmp_folder/$cfg.conf"

    {
        echo "[Interface]"
    } >"$conf"

    write_opt "$cfg" QuicEndpoint
    write_opt "$cfg" WgListen
    write_opt "$cfg" QuicListen
    write_opt "$cfg" CertsPath
    write_opt "$cfg" SNI
    write_opt "$cfg" LogPath
    write_opt "$cfg" StatPath

    config_foreach write_peer_section peer "$cfg"

    procd_open_instance "$cfg"
    procd_set_param command "$bin" "$conf"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param respawn 0 0 0
    procd_close_instance
}

start_service() {
    config_load "$prog_name"

    if [ -n "$1" ]; then
        instance_parse "$1"
    else
        config_foreach instance_parse instance
    fi
}

reload_service() {
    stop "$@"
    start "$@"
}

restart_service() {
    reload_service "$@"
}

service_triggers() {
    procd_add_reload_trigger "$prog_name"
}
